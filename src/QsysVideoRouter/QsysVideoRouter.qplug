-- Information block for the plugin
PluginInfo = {
	Name = "Video~Q-SYS Video Router",
	Description = "Source-first (or destination-first) matrix routing and one-to-all routing for a Router, Router with Mixer, or MediaCast Router component, with a selectable routed-source combo box per destination and per-source and per-destination visibility control.",
	Version = "1.1.1.0",
	BuildVersion = "1.1.1.0",
	Id = "4310fd53-d142-4f99-b1be-6d17ed7fb85a",
	Author = "CTI, Isaac Porter",
}

--[[
###############################################################################
#
# Q-SYS Video Router
# Copyright 2026 Communication Technologies, Inc. (CTI)
#
# Front end for a Router / Router with Mixer / MediaCast Router component in
# the design. Sources are on the left, destinations on the right. Two routing
# modes:
#
#   One-To-One (Matrix) -- pick a source, then the destinations to send it to.
#                          Source buttons are interlocked; every destination
#                          already carrying the armed source highlights.
#                          "Matrix Select Order" flips the two axes.
#   One-To-All          -- pick a source; it is routed to every router output.
#
# Each destination also carries a routed-source ComboBox, which both reads the
# route back and sets it.
#
# Per-source and per-destination visibility input pins hide entries that are
# not physically connected.
#
# Based on the QSC, LLC. plugin framework.
#
###############################################################################
]]

-- Resources (palette, page list)
-- CTI brand colour palette (see cti_brand_preferences.md)
Palette = {
	cti_navy  = {13, 59, 102},   -- CTI Dark Blue  #0D3B66
	cti_teal  = {0, 169, 165},   -- CTI Teal       #00A9A5
	cti_amber = {255, 186, 73},  -- CTI Amber      #FFBA49
	White     = {255, 255, 255},
	Black     = {0, 0, 0},
	Gray      = {128, 128, 128},
	Red       = {200, 40, 40},
	Green     = {40, 180, 80},
	btn_off   = {124, 124, 124},  -- #7C7C7C
	green_on  = {0, 159, 60},     -- #009F3C
	green_off = {0, 75, 22},      -- #004B16
	gray_off  = {137, 137, 137},  -- #898989
	led_off   = {16, 40, 24}
}

-- Pages shown by the plugin
PageNames = { "Control", "Setup" }

-- Layout geometry shared by both pages. Grids wrap into columns once they
-- exceed COLUMN_ROWS entries so a 32-destination router stays on screen.
Geometry = {
	COLUMN_ROWS = 16,
	rowH        = 30,
	btnW        = 30,
	btnH        = 26,
	nameW       = 132,
	srcNameW    = 150,
	fs          = 12,
	labelH      = 20
}

-- Define the colour of the plugin object in the design
function GetColor(props)
	return Palette.cti_navy
end

-- The name that initially displays when dragged into a design
function GetPrettyName(props)
	return "Q-SYS Video Router v" .. PluginInfo.Version
end

-- Optional function used if the plugin has multiple pages
function GetPages(props)
	local pages = {}
	for thisPage in ipairs(PageNames) do
		table.insert(pages, {name = PageNames[thisPage]})
	end
	return pages
end

-- Optional function to define model if the plugin supports more than one model
function GetModel(props)
	local model = {}
	-- Single model; nothing to define.
	return model
end

-- Define user-configurable Properties of the plugin
function GetProperties()
	local props = {}
	table.insert(props, {
		Name = "Source Count",
		Type = "integer",
		Value = 8,
		Min = 1,
		Max = 64
	})
	table.insert(props, {
		Name = "Destination Count",
		Type = "integer",
		Value = 4,
		Min = 1,
		Max = 64
	})
	table.insert(props, {
		Name = "Default Mode",
		Type = "enum",
		Choices = {"One-To-One (Matrix)", "One-To-All"},
		Value = "One-To-One (Matrix)"
	})
	-- One-To-One selection order. Source First: pick a source, then the
	-- destinations to send it to. Destination First: pick a destination, then its
	-- source.
	table.insert(props, {
		Name = "Matrix Select Order",
		Type = "enum",
		Choices = {"Destination First", "Source First"},
		Value = "Source First"
	})
	table.insert(props, {
		Name = "Debug Print",
		Type = "enum",
		Choices = {"None", "Function Calls", "Routes", "All"},
		Value = "None"
	})
	return props
end

-- Optional function to define pins not connected to a Control
function GetPins(props)
	local pins = {}
	-- All pins are derived from Controls (UserPin); no extra pins required.
	return pins
end

-- Optional function to update available properties when properties are altered
function RectifyProperties(props)
	-- No conditional property visibility required.
	return props
end

-- Optional function to define components used within the plugin
function GetComponents(props)
	local components = {}
	-- This plugin proxies to a router component elsewhere in the design at runtime
	-- via the Component library; it hosts no internal components.
	return components
end

-- Optional function to define wiring of components used within the plugin
function GetWiring(props)
	local wiring = {}
	-- No internal components, so no wiring.
	return wiring
end

-- Defines the Controls used within the plugin
function GetControls(props)
	local ctrls = {}
		local fmt = string.format
		local SourceCount = props["Source Count"].Value
		local DestCount   = props["Destination Count"].Value
	
		-- Router binding and diagnostics ---------------------------------------------
		table.insert(ctrls, {
			Name = "router_select",
			ControlType = "Text",
			Count = 1,
			UserPin = true,
			PinStyle = "Both"
		})
		table.insert(ctrls, {
			Name = "router_found",
			ControlType = "Indicator",
			IndicatorType = "Led",
			DefaultValue = false,
			Count = 1,
			UserPin = true,
			PinStyle = "Output"
		})
		-- Which select-control naming form resolved on the bound component.
		-- Classic Router = "select.N", MediaCast Router = "output.N.select".
		table.insert(ctrls, {
			Name = "router_style",
			ControlType = "Indicator",
			IndicatorType = "Text",
			Count = 1,
			UserPin = true,
			PinStyle = "Output"
		})
		table.insert(ctrls, {
			Name = "status",
			ControlType = "Indicator",
			IndicatorType = "Status",
			Count = 1,
			UserPin = true,
			PinStyle = "Output"
		})
	
		-- Mode selection -------------------------------------------------------------
		table.insert(ctrls, {
			Name = "mode_matrix",
			ControlType = "Button",
			ButtonType = "Toggle",
			Count = 1,
			UserPin = true,
			PinStyle = "Both"
		})
		table.insert(ctrls, {
			Name = "mode_all",
			ControlType = "Button",
			ButtonType = "Toggle",
			Count = 1,
			UserPin = true,
			PinStyle = "Both"
		})
		table.insert(ctrls, {
			Name = "mode_name",
			ControlType = "Indicator",
			IndicatorType = "Text",
			Count = 1,
			UserPin = true,
			PinStyle = "Output"
		})
		-- Whichever axis is the interlocked selector reports its selection here. In
		-- destination-first order only selected_dest_name is populated; in
		-- source-first order only selected_source_name is.
		table.insert(ctrls, {
			Name = "selected_dest_name",
			ControlType = "Indicator",
			IndicatorType = "Text",
			Count = 1,
			UserPin = true,
			PinStyle = "Output"
		})
		table.insert(ctrls, {
			Name = "selected_source_name",
			ControlType = "Indicator",
			IndicatorType = "Text",
			Count = 1,
			UserPin = true,
			PinStyle = "Output"
		})
	
		-- Destinations ---------------------------------------------------------------
		for thisDest = 1, DestCount do
			-- Interlocked destination selector (One-To-One mode).
			table.insert(ctrls, {
				Name = fmt("dest_select_%03d", thisDest),
				ControlType = "Button",
				ButtonType = "Toggle",
				Count = 1,
				UserPin = true,
				PinStyle = "Both"
			})
			-- User-supplied destination label.
			table.insert(ctrls, {
				Name = fmt("dest_name_%03d", thisDest),
				ControlType = "Text",
				Count = 1,
				UserPin = true,
				PinStyle = "Both"
			})
			-- Drive low to hide this destination (nothing plugged in).
			table.insert(ctrls, {
				Name = fmt("dest_visible_%03d", thisDest),
				ControlType = "Button",
				ButtonType = "Toggle",
				DefaultValue = true,
				Count = 1,
				UserPin = true,
				PinStyle = "Both"
			})
			-- Source currently routed to this destination. Laid out as a ComboBox, so
			-- it both reads the route back and sets it.
			table.insert(ctrls, {
				Name = fmt("dest_source_%03d", thisDest),
				ControlType = "Text",
				Count = 1,
				UserPin = true,
				PinStyle = "Both"
			})
			-- Numeric readout of the routed source index (0 = none / unknown).
			table.insert(ctrls, {
				Name = fmt("dest_route_%03d", thisDest),
				ControlType = "Knob",
				ControlUnit = "Integer",
				Min = 0,
				Max = 64,
				DefaultValue = 0,
				Count = 1,
				UserPin = true,
				PinStyle = "Output"
			})
		end
	
		-- Sources --------------------------------------------------------------------
		for thisSource = 1, SourceCount do
			-- Press to route. Lit state is driven from router feedback, never from
			-- the press itself.
			table.insert(ctrls, {
				Name = fmt("source_select_%03d", thisSource),
				ControlType = "Button",
				ButtonType = "Toggle",
				Count = 1,
				UserPin = true,
				PinStyle = "Both"
			})
			table.insert(ctrls, {
				Name = fmt("source_name_%03d", thisSource),
				ControlType = "Text",
				Count = 1,
				UserPin = true,
				PinStyle = "Both"
			})
			-- Drive low to hide this source (nothing plugged in).
			table.insert(ctrls, {
				Name = fmt("source_visible_%03d", thisSource),
				ControlType = "Button",
				ButtonType = "Toggle",
				DefaultValue = true,
				Count = 1,
				UserPin = true,
				PinStyle = "Both"
			})
		end
	return ctrls
end

-- Layout of controls and graphics for the plugin UI
function GetControlLayout(props)
	local layout = {}
	local graphics = {}
		local fmt = string.format
		local pidx = (props["page_index"] and props["page_index"].Value) or 1
		local CurrentPage = PageNames[pidx]
	
		local SourceCount = props["Source Count"].Value
		local DestCount   = props["Destination Count"].Value
		local SourceFirst = (props["Matrix Select Order"].Value == "Source First")
	
		local G       = Geometry
		local fs      = G.fs
		local rowH    = G.rowH
		local btnW    = G.btnW
		local btnH    = G.btnH
		local nameW   = G.nameW
		local labelH  = G.labelH
		local colRows = G.COLUMN_ROWS
	
		-- Grid geometry. Both grids wrap into columns of COLUMN_ROWS entries.
		local destCols = math.ceil(DestCount / colRows)
		local destRows = math.min(DestCount, colRows)
		local srcCols  = math.ceil(SourceCount / colRows)
		local srcRows  = math.min(SourceCount, colRows)
	
		local destCellW = btnW + 6 + nameW + 6 + nameW
		local srcCellW  = btnW + 6 + G.srcNameW
	
		local destGW = 16 + destCols * destCellW + (destCols - 1) * 12
		local srcGW  = 16 + srcCols * srcCellW + (srcCols - 1) * 12
	
		-- Sources on the left, destinations on the right: signal flows left to right.
		local gridY = 34
		local srcGX, srcGY = 0, gridY
		local srcGH = 28 + srcRows * rowH + 10
		local destGX, destGY = srcGX + srcGW + 14, gridY
		local destGH = 28 + destRows * rowH + 10
	
		local totalW = destGX + destGW
		local footY  = gridY + math.max(destGH, srcGH) + 14
	
		-- Shared cell-position helper for a wrapping grid.
		local function CellPos(index, originX, originY, cellW)
			local col = math.floor((index - 1) / colRows)
			local row = (index - 1) % colRows
			return originX + 8 + col * (cellW + 12), originY + 28 + row * rowH
		end
	
		local function TitleBlock(width)
			table.insert(graphics, {
				Type = "Text", Text = "Q-SYS Video Router", FontSize = 16,
				FontStyle = "Bold", HTextAlign = "Left", Color = Palette.cti_navy,
				Position = {0, 4}, Size = {320, 24}
			})
			table.insert(graphics, {
				Type = "Text", Text = "v" .. PluginInfo.BuildVersion, FontSize = fs,
				HTextAlign = "Right", Color = Palette.Gray,
				Position = {width - 120, 8}, Size = {120, labelH}
			})
		end
	
		if CurrentPage == "Control" then
	
			TitleBlock(totalW)
	
			-- Sources --------------------------------------------------------------
			-- Group titles carry the step order so the surface reads correctly
			-- without a separate instruction line.
			table.insert(graphics, {
				Type = "GroupBox",
				Text = SourceFirst and "Sources (1. select)" or "Sources (2. route)",
				FontSize = fs, HTextAlign = "Left",
				Fill = Palette.White, StrokeColor = Palette.cti_navy, StrokeWidth = 1,
				CornerRadius = 8, Position = {srcGX, srcGY}, Size = {srcGW, srcGH}
			})
			for thisSource = 1, SourceCount do
				local cellX, cellY = CellPos(thisSource, srcGX, srcGY, srcCellW)
				layout[fmt("source_select_%03d", thisSource)] = {
					PrettyName = fmt("Sources~%d Select", thisSource),
					Legend = tostring(thisSource), FontSize = fs, Style = "Button",
					Color = Palette.green_on, OffColor = Palette.cti_navy, UnlinkOffColor = true,
					Margin = 3, Position = {cellX, cellY}, Size = {btnW, btnH}
				}
				layout[fmt("source_name_%03d", thisSource)] = {
					PrettyName = fmt("Sources~%d Name", thisSource),
					Style = "Text", FontSize = fs, HTextAlign = "Left",
					Color = Palette.White, Padding = 2, StrokeWidth = 1,
					Position = {cellX + btnW + 6, cellY + 1}, Size = {G.srcNameW, btnH - 2}
				}
			end
	
			-- Destinations ---------------------------------------------------------
			table.insert(graphics, {
				Type = "GroupBox",
				Text = SourceFirst and "Destinations (2. route to)" or "Destinations (1. select)",
				FontSize = fs, HTextAlign = "Left",
				Fill = Palette.White, StrokeColor = Palette.cti_navy, StrokeWidth = 1,
				CornerRadius = 8, Position = {destGX, destGY}, Size = {destGW, destGH}
			})
			for thisCol = 0, destCols - 1 do
				local headX = destGX + 8 + thisCol * (destCellW + 12)
				table.insert(graphics, {
					Type = "Text", Text = "Routed Source", FontSize = 10, HTextAlign = "Left",
					Color = Palette.Gray,
					Position = {headX + btnW + 12 + nameW, destGY + 12}, Size = {nameW, 14}
				})
			end
	
			for thisDest = 1, DestCount do
				local cellX, cellY = CellPos(thisDest, destGX, destGY, destCellW)
				layout[fmt("dest_select_%03d", thisDest)] = {
					PrettyName = fmt("Destinations~%d Select", thisDest),
					Legend = tostring(thisDest), FontSize = fs, Style = "Button",
					Color = Palette.cti_amber, OffColor = Palette.cti_navy, UnlinkOffColor = true,
					Margin = 3, Position = {cellX, cellY}, Size = {btnW, btnH}
				}
				layout[fmt("dest_name_%03d", thisDest)] = {
					PrettyName = fmt("Destinations~%d Name", thisDest),
					Style = "Text", FontSize = fs, HTextAlign = "Left",
					Color = Palette.White, Padding = 2, StrokeWidth = 1,
					Position = {cellX + btnW + 6, cellY + 1}, Size = {nameW, btnH - 2}
				}
				-- ComboBox, not a readout: picking a source here routes this output.
				layout[fmt("dest_source_%03d", thisDest)] = {
					PrettyName = fmt("Destinations~%d Routed Source", thisDest),
					Style = "ComboBox", FontSize = fs,
					Color = Palette.White, Padding = 2, StrokeWidth = 1,
					Position = {cellX + btnW + 6 + nameW + 6, cellY + 1}, Size = {nameW, btnH - 2}
				}
			end
	
			-- Footer: bound router and status --------------------------------------
			table.insert(graphics, {
				Type = "GroupBox", Text = "Router", FontSize = fs, HTextAlign = "Left",
				Fill = Palette.White, StrokeColor = Palette.cti_navy, StrokeWidth = 1,
				CornerRadius = 8, Position = {0, footY}, Size = {totalW, 58}
			})
			layout["status"] = {
				PrettyName = "Router~Status", Style = "Text", FontSize = fs,
				HTextAlign = "Left", Color = Palette.White, Padding = 2, StrokeWidth = 1,
				Position = {12, footY + 22}, Size = {totalW - 220, btnH}
			}
			table.insert(graphics, {
				Type = "Text", Text = "Naming", FontSize = fs, HTextAlign = "Right",
				Color = Palette.cti_navy, Position = {totalW - 202, footY + 25}, Size = {56, labelH}
			})
			layout["router_style"] = {
				PrettyName = "Router~Control Naming", Style = "Text", FontSize = fs,
				HTextAlign = "Center", Color = Palette.White, Padding = 2, StrokeWidth = 1,
				Position = {totalW - 142, footY + 22}, Size = {104, btnH}
			}
			layout["router_found"] = {
				PrettyName = "Router~Found", Style = "Indicator",
				Color = Palette.Green, OffColor = Palette.led_off, UnlinkOffColor = true,
				StrokeWidth = 1, Margin = 2,
				Position = {totalW - 28, footY + 26}, Size = {18, 18}
			}
	
		elseif CurrentPage == "Setup" then
	
			local setupW = 470
			TitleBlock(setupW)
	
			-- Router binding -------------------------------------------------------
			table.insert(graphics, {
				Type = "GroupBox", Text = "Router Component", FontSize = fs, HTextAlign = "Left",
				Fill = Palette.White, StrokeColor = Palette.cti_navy, StrokeWidth = 1,
				CornerRadius = 8, Position = {0, 34}, Size = {setupW, 92}
			})
			table.insert(graphics, {
				Type = "Text", Text = "Router", FontSize = fs, HTextAlign = "Left",
				Color = Palette.cti_navy, Position = {12, 59}, Size = {50, labelH}
			})
			layout["router_select"] = {
				PrettyName = "Router~Component", Style = "ComboBox", FontSize = fs,
				Color = Palette.White, Padding = 2, StrokeWidth = 1,
				Position = {64, 56}, Size = {setupW - 104, 24}
			}
			layout["router_found"] = {
				PrettyName = "Router~Found", Style = "Indicator",
				Color = Palette.Green, OffColor = Palette.led_off, UnlinkOffColor = true,
				StrokeWidth = 1, Margin = 2, Position = {setupW - 28, 59}, Size = {18, 18}
			}
			layout["status"] = {
				PrettyName = "Router~Status", Style = "Text", FontSize = fs,
				HTextAlign = "Left", Color = Palette.White, Padding = 2, StrokeWidth = 1,
				Position = {12, 90}, Size = {setupW - 140, 24}
			}
			layout["router_style"] = {
				PrettyName = "Router~Control Naming", Style = "Text", FontSize = fs,
				HTextAlign = "Center", Color = Palette.White, Padding = 2, StrokeWidth = 1,
				Position = {setupW - 120, 90}, Size = {108, 24}
			}
	
			-- Current selection ----------------------------------------------------
			-- Only the interlocked axis has a meaningful selection, so the other
			-- readout stays empty; both are drawn so neither pin is hidden.
			table.insert(graphics, {
				Type = "GroupBox",
				Text = SourceFirst and "Selection (source first)" or "Selection (destination first)",
				FontSize = fs, HTextAlign = "Left",
				Fill = Palette.White, StrokeColor = Palette.cti_navy, StrokeWidth = 1,
				CornerRadius = 8, Position = {0, 134}, Size = {setupW, 58}
			})
			table.insert(graphics, {
				Type = "Text", Text = "Source", FontSize = 10, HTextAlign = "Left",
				Color = Palette.Gray, Position = {12, 156}, Size = {50, 14}
			})
			layout["selected_source_name"] = {
				PrettyName = "Mode~Selected Source", Style = "Text", FontSize = fs,
				HTextAlign = "Center", Color = Palette.White, Padding = 2, StrokeWidth = 1,
				Position = {64, 154}, Size = {140, 24}
			}
			table.insert(graphics, {
				Type = "Text", Text = "Destination", FontSize = 10, HTextAlign = "Left",
				Color = Palette.Gray, Position = {216, 156}, Size = {70, 14}
			})
			layout["selected_dest_name"] = {
				PrettyName = "Mode~Selected Destination", Style = "Text", FontSize = fs,
				HTextAlign = "Center", Color = Palette.White, Padding = 2, StrokeWidth = 1,
				Position = {288, 154}, Size = {setupW - 300, 24}
			}
	
			-- Source setup ---------------------------------------------------------
			-- A GroupBox title is drawn as a tab hanging down from the top border, so
			-- the column headers sit below it (hdrDY) rather than beside it, where the
			-- "Name" header collided with the "Sources" / "Destinations" title.
			local hdrDY = 18
			local rowDY = 36
			local sSetupY = 200
			local sSetupH = rowDY + SourceCount * rowH + 10
			table.insert(graphics, {
				Type = "GroupBox", Text = "Sources", FontSize = fs, HTextAlign = "Left",
				Fill = Palette.White, StrokeColor = Palette.cti_navy, StrokeWidth = 1,
				CornerRadius = 8, Position = {0, sSetupY}, Size = {setupW, sSetupH}
			})
			table.insert(graphics, {
				Type = "Text", Text = "Name", FontSize = 10, HTextAlign = "Left",
				Color = Palette.Gray, Position = {44, sSetupY + hdrDY}, Size = {60, 14}
			})
			table.insert(graphics, {
				Type = "Text", Text = "Visible", FontSize = 10, HTextAlign = "Center",
				Color = Palette.Gray, Position = {setupW - 132, sSetupY + hdrDY}, Size = {56, 14}
			})
			for thisSource = 1, SourceCount do
				local rowY = sSetupY + rowDY + (thisSource - 1) * rowH
				table.insert(graphics, {
					Type = "Text", Text = tostring(thisSource), FontSize = fs, HTextAlign = "Right",
					Color = Palette.cti_navy, Position = {8, rowY + 3}, Size = {28, labelH}
				})
				layout[fmt("source_name_%03d", thisSource)] = {
					PrettyName = fmt("Sources~%d Name", thisSource),
					Style = "Text", FontSize = fs, HTextAlign = "Left",
					Color = Palette.White, Padding = 2, StrokeWidth = 1,
					Position = {44, rowY + 1}, Size = {setupW - 190, btnH - 2}
				}
				layout[fmt("source_visible_%03d", thisSource)] = {
					PrettyName = fmt("Sources~%d Visible", thisSource),
					Legend = "", Style = "Button",
					Color = Palette.green_on, OffColor = Palette.gray_off, UnlinkOffColor = true,
					Margin = 3, Position = {setupW - 122, rowY}, Size = {36, btnH}
				}
			end
	
			-- Destination setup ----------------------------------------------------
			local dSetupY = sSetupY + sSetupH + 14
			local dSetupH = rowDY + DestCount * rowH + 10
			table.insert(graphics, {
				Type = "GroupBox", Text = "Destinations", FontSize = fs, HTextAlign = "Left",
				Fill = Palette.White, StrokeColor = Palette.cti_navy, StrokeWidth = 1,
				CornerRadius = 8, Position = {0, dSetupY}, Size = {setupW, dSetupH}
			})
			table.insert(graphics, {
				Type = "Text", Text = "Name", FontSize = 10, HTextAlign = "Left",
				Color = Palette.Gray, Position = {44, dSetupY + hdrDY}, Size = {60, 14}
			})
			table.insert(graphics, {
				Type = "Text", Text = "Visible", FontSize = 10, HTextAlign = "Center",
				Color = Palette.Gray, Position = {setupW - 132, dSetupY + hdrDY}, Size = {56, 14}
			})
			table.insert(graphics, {
				Type = "Text", Text = "Route", FontSize = 10, HTextAlign = "Center",
				Color = Palette.Gray, Position = {setupW - 64, dSetupY + hdrDY}, Size = {52, 14}
			})
			for thisDest = 1, DestCount do
				local rowY = dSetupY + rowDY + (thisDest - 1) * rowH
				table.insert(graphics, {
					Type = "Text", Text = tostring(thisDest), FontSize = fs, HTextAlign = "Right",
					Color = Palette.cti_navy, Position = {8, rowY + 3}, Size = {28, labelH}
				})
				layout[fmt("dest_name_%03d", thisDest)] = {
					PrettyName = fmt("Destinations~%d Name", thisDest),
					Style = "Text", FontSize = fs, HTextAlign = "Left",
					Color = Palette.White, Padding = 2, StrokeWidth = 1,
					Position = {44, rowY + 1}, Size = {setupW - 190, btnH - 2}
				}
				layout[fmt("dest_visible_%03d", thisDest)] = {
					PrettyName = fmt("Destinations~%d Visible", thisDest),
					Legend = "", Style = "Button",
					Color = Palette.green_on, OffColor = Palette.gray_off, UnlinkOffColor = true,
					Margin = 3, Position = {setupW - 122, rowY}, Size = {36, btnH}
				}
				layout[fmt("dest_route_%03d", thisDest)] = {
					PrettyName = fmt("Destinations~%d Routed Index", thisDest),
					Style = "Text", FontSize = fs, HTextAlign = "Center",
					Color = Palette.White, OffColor = Palette.White, UnlinkOffColor = true,
					Padding = 2, StrokeWidth = 1,
					Position = {setupW - 64, rowY + 1}, Size = {52, btnH - 2}
				}
			end
	
		end
	return layout, graphics
end

-- Start event-based logic
if Controls then
		local fmt = string.format
	
		local SourceCount = Properties["Source Count"].Value
		local DestCount   = Properties["Destination Count"].Value
		local DefaultMode = Properties["Default Mode"].Value
		local DebugMode   = Properties["Debug Print"].Value
	
		local function dbg(...)
			if DebugMode ~= "None" then print("[VidRouter]", ...) end
		end
	
		local function dbgRoute(...)
			if DebugMode == "Routes" or DebugMode == "All" then print("[VidRouter]", ...) end
		end
	
		local STATUS = {OK = 0, COMPROMISED = 1, FAULT = 2, NOT_PRESENT = 3, MISSING = 5}
	
		local MODE_MATRIX = "matrix"
		local MODE_ALL    = "all"
	
		-- Which axis is the interlocked selector in One-To-One mode.
		--   ORDER_SOURCE -- pick a source, then pick the destinations to send it to
		--                   (default)
		--   ORDER_DEST   -- pick a destination, then pick its source
		local ORDER_DEST   = "dest"
		local ORDER_SOURCE = "source"
		local SelectOrder  =
			(Properties["Matrix Select Order"].Value == "Source First") and ORDER_SOURCE or ORDER_DEST
	
		local RouterProxy     = nil    -- bound router component, or nil
		local SelectCtlCache  = {}     -- [destination] = resolved select control name
		local BoundSelectCtls = {}     -- [destination] = control name we subscribed to
		local SelectedDest    = 1      -- interlocked selection when ORDER_DEST
		local SelectedSource  = 1      -- interlocked selection when ORDER_SOURCE
		local Mode            = (DefaultMode == "One-To-All") and MODE_ALL or MODE_MATRIX
	
		-- Depth counter, not a boolean: nested feedback writes must not clear the
		-- guard early. See qsys_preferences.md (write-suppression rules).
		local Suppress = 0
		local function BeginSuppress() Suppress = Suppress + 1 end
		local function EndSuppress()
			Suppress = Suppress - 1
			if Suppress < 0 then Suppress = 0 end
		end
		local function Suppressed() return Suppress > 0 end
	
		-- ===== Conditional writers =====
		-- Every feedback write is conditional so a settled control emits no events
		-- at all. This is the load-bearing protection against feedback loops; the
		-- suppression counter above is only a fast path.
		local function SetBool(ctl, want)
			if ctl ~= nil and ctl.Boolean ~= want then ctl.Boolean = want end
		end
	
		local function SetString(ctl, want)
			if ctl ~= nil and ctl.String ~= want then ctl.String = want end
		end
	
		local function SetValue(ctl, want)
			if ctl ~= nil and ctl.Value ~= want then ctl.Value = want end
		end
	
		local function SetFlag(ctl, flag, want)
			if ctl ~= nil and ctl[flag] ~= want then ctl[flag] = want end
		end
	
		local function SetStatus(code, message)
			local ctl = Controls["status"]
			if ctl == nil then return end
			SetValue(ctl, code)
			SetString(ctl, message)
		end
	
		-- ===== Control accessors =====
		local function DestCtl(kind, thisDest)
			return Controls[fmt("dest_%s_%03d", kind, thisDest)]
		end
	
		local function SourceCtl(kind, thisSource)
			return Controls[fmt("source_%s_%03d", kind, thisSource)]
		end
	
		local function DestVisible(thisDest)
			local ctl = DestCtl("visible", thisDest)
			return (ctl == nil) or ctl.Boolean
		end
	
		local function SourceVisible(thisSource)
			local ctl = SourceCtl("visible", thisSource)
			return (ctl == nil) or ctl.Boolean
		end
	
		local function SourceLabel(thisSource)
			if thisSource == nil then return "" end
			local ctl = SourceCtl("name", thisSource)
			if ctl ~= nil and ctl.String ~= nil and ctl.String ~= "" then return ctl.String end
			return fmt("Source %d", thisSource)
		end
	
		local function DestLabel(thisDest)
			if thisDest == nil then return "" end
			local ctl = DestCtl("name", thisDest)
			if ctl ~= nil and ctl.String ~= nil and ctl.String ~= "" then return ctl.String end
			return fmt("Destination %d", thisDest)
		end
	
		local function FirstVisibleDest()
			for thisDest = 1, DestCount do
				if DestVisible(thisDest) then return thisDest end
			end
			return 1
		end
	
		local function FirstVisibleSource()
			for thisSource = 1, SourceCount do
				if SourceVisible(thisSource) then return thisSource end
			end
			return 1
		end
	
		-- ===== Routed-source combo boxes =====
		-- Each destination's routed-source field is a ComboBox: it reads the route
		-- back and can also set it. A choice string has to map back to exactly one
		-- source, so two sources sharing a name are disambiguated by index.
		--
		-- A router output cannot be unrouted -- select is 1-based with no "off"
		-- position -- so the list carries sources only. An output whose route cannot
		-- be read reads back blank rather than offering a way to clear it.
		local ChoiceLabel = {}     -- [source] = unique label for that source
		local ChoiceIndex = {}     -- [label]  = source index
		local ChoiceList  = {}     -- ordered choices offered on every destination
		local ChoiceSig   = nil    -- signature of the last list written
	
		local function BuildSourceChoices()
			ChoiceLabel = {}
			ChoiceIndex = {}
			ChoiceList  = {}
			local taken = {}
			for thisSource = 1, SourceCount do
				local label = SourceLabel(thisSource)
				if taken[label] then label = fmt("%s (%d)", label, thisSource) end
				taken[label] = true
				ChoiceLabel[thisSource] = label
				ChoiceIndex[label] = thisSource
				-- A hidden source is not part of the surface, so it is not offered.
				if SourceVisible(thisSource) then table.insert(ChoiceList, label) end
			end
		end
	
		-- Writing Choices raises no control event, but the list only changes when a
		-- name or a visibility flag does, so skip the write while it is settled.
		local function WriteSourceChoices()
			local sig = table.concat(ChoiceList, "\n")
			if sig == ChoiceSig then return end
			ChoiceSig = sig
			BeginSuppress()
			for thisDest = 1, DestCount do
				local ctl = DestCtl("source", thisDest)
				if ctl ~= nil then ctl.Choices = ChoiceList end
			end
			EndSuppress()
		end
	
		local function RefreshSourceChoices()
			BuildSourceChoices()
			WriteSourceChoices()
		end
	
		-- ===== Router component access =====
		local function HasControl(comp, name)
			if comp == nil then return false end
			local ok, ctl = pcall(function() return comp[name] end)
			return ok and ctl ~= nil
		end
	
		-- The classic Router / Router with Mixer names the output selector
		-- "select.N". The MediaCast Router renamed it to "output.N.select" -- the
		-- index comes BEFORE "select". Hardcoding either form silently fails on the
		-- other (no error, the control just never resolves), so probe both and
		-- cache the winner per destination.
		local function ResolveSelectCtl(thisDest)
			if SelectCtlCache[thisDest] ~= nil then return SelectCtlCache[thisDest] end
			if RouterProxy == nil then return nil end
			local candidates = {fmt("select.%d", thisDest), fmt("output.%d.select", thisDest)}
			for _, thisCandidate in ipairs(candidates) do
				if HasControl(RouterProxy, thisCandidate) then
					SelectCtlCache[thisDest] = thisCandidate
					return thisCandidate
				end
			end
			return nil
		end
	
		local function GetRoute(thisDest)
			local selCtl = ResolveSelectCtl(thisDest)
			if selCtl == nil then return nil end
			local routed
			local ok = pcall(function() routed = RouterProxy[selCtl].Value end)
			if not ok or routed == nil then return nil end
			return math.floor(routed)
		end
	
		local function SetRoute(thisDest, thisSource)
			local selCtl = ResolveSelectCtl(thisDest)
			if selCtl == nil then return false end
			local applied = false
			pcall(function()
				local current = RouterProxy[selCtl].Value
				if current == nil or math.floor(current) ~= thisSource then
					RouterProxy[selCtl].Value = thisSource
				end
				applied = true
			end)
			if applied then dbgRoute("routed destination", thisDest, "<- source", thisSource) end
			return applied
		end
	
		-- ===== Feedback =====
		-- In One-To-All mode a source lights only when every destination sits on it.
		local function CommonRoute()
			local common = nil
			for thisDest = 1, DestCount do
				local routed = GetRoute(thisDest)
				if routed == nil then return nil end
				if common == nil then
					common = routed
				elseif common ~= routed then
					return nil
				end
			end
			return common
		end
	
		-- Source buttons are the interlocked selector in source-first order, and a
		-- readout of the selected destination's route otherwise.
		local function WriteSourceButtons()
			local lit
			if Mode == MODE_ALL then
				lit = CommonRoute()
			elseif SelectOrder == ORDER_SOURCE then
				lit = SelectedSource
			else
				lit = GetRoute(SelectedDest)
			end
			BeginSuppress()
			for thisSource = 1, SourceCount do
				-- A hidden entry is not part of the surface, so it never stays lit.
				SetBool(SourceCtl("select", thisSource),
					(thisSource == lit) and SourceVisible(thisSource))
			end
			EndSuppress()
		end
	
		-- Destination buttons are the interlocked selector in destination-first
		-- order. In source-first order they instead show every output that already
		-- carries the selected source, so more than one can be lit.
		local function WriteDestButtons()
			local destText, sourceText = "", ""
			if Mode == MODE_ALL then
				destText = "All"
			elseif SelectOrder == ORDER_SOURCE then
				sourceText = SourceLabel(SelectedSource)
			else
				destText = DestLabel(SelectedDest)
			end
	
			BeginSuppress()
			for thisDest = 1, DestCount do
				local lit = false
				if Mode == MODE_MATRIX then
					if SelectOrder == ORDER_SOURCE then
						lit = (SelectedSource ~= nil) and (GetRoute(thisDest) == SelectedSource)
					else
						lit = (thisDest == SelectedDest)
					end
				end
				-- A hidden entry is not part of the surface, so it never stays lit.
				SetBool(DestCtl("select", thisDest), lit and DestVisible(thisDest))
			end
			SetString(Controls["selected_dest_name"], destText)
			SetString(Controls["selected_source_name"], sourceText)
			EndSuppress()
		end
	
		-- The routed-source combo must read back a string from its own choice list,
		-- so the label comes from this plugin's source names, not from whatever the
		-- router calls the source.
		local function WriteRouteReadouts()
			BeginSuppress()
			for thisDest = 1, DestCount do
				local routed = GetRoute(thisDest)
				local label = ""              -- no router bound, or output unresolved
				if routed ~= nil and routed >= 1 then
					label = ChoiceLabel[routed] or fmt("Source %d", routed)
				end
				SetString(DestCtl("source", thisDest), label)
				SetValue(DestCtl("route", thisDest), routed or 0)
			end
			EndSuppress()
		end
	
		-- Single idempotent refresh. Every write inside is conditional, so calling
		-- this more often than strictly needed costs a few comparisons and cannot
		-- generate control events on a settled system.
		local function RefreshAll()
			WriteDestButtons()
			WriteSourceButtons()
			WriteRouteReadouts()
		end
	
		-- ===== Visibility =====
		-- Sources / destinations that are not physically connected are hidden. The
		-- same pins are exposed so a UCI can bind element visibility to them.
		local function ApplyVisibility()
			-- The routed-source combos only offer visible sources, so their choice
			-- list is rebuilt whenever visibility changes.
			RefreshSourceChoices()
			for thisSource = 1, SourceCount do
				local hidden = not SourceVisible(thisSource)
				SetFlag(SourceCtl("select", thisSource), "IsInvisible", hidden)
				SetFlag(SourceCtl("select", thisSource), "IsDisabled", hidden)
				SetFlag(SourceCtl("name", thisSource), "IsInvisible", hidden)
			end
			for thisDest = 1, DestCount do
				local hidden = not DestVisible(thisDest)
				SetFlag(DestCtl("select", thisDest), "IsInvisible", hidden)
				-- Destination selection is also meaningless in One-To-All mode.
				SetFlag(DestCtl("select", thisDest), "IsDisabled", hidden or (Mode == MODE_ALL))
				SetFlag(DestCtl("name", thisDest), "IsInvisible", hidden)
				SetFlag(DestCtl("source", thisDest), "IsInvisible", hidden)
				-- Routing one output on its own contradicts One-To-All, so the combo
				-- is locked out there just like the destination button.
				SetFlag(DestCtl("source", thisDest), "IsDisabled", hidden or (Mode == MODE_ALL))
			end
			-- Never leave a selection parked on a hidden entry.
			if not DestVisible(SelectedDest) then SelectedDest = FirstVisibleDest() end
			if not SourceVisible(SelectedSource) then SelectedSource = FirstVisibleSource() end
			-- Visibility also gates the lit state, so always re-assert the surface.
			RefreshAll()
		end
	
		local function ApplyMode()
			BeginSuppress()
			SetBool(Controls["mode_matrix"], Mode == MODE_MATRIX)
			SetBool(Controls["mode_all"], Mode == MODE_ALL)
			SetString(Controls["mode_name"], (Mode == MODE_MATRIX) and "Matrix" or "All")
			EndSuppress()
			ApplyVisibility()
			RefreshAll()
			dbg("mode", Mode, "order", SelectOrder)
		end
	
		-- ===== Router binding =====
		local function UnbindRouter()
			for _, thisCtlName in pairs(BoundSelectCtls) do
				if HasControl(RouterProxy, thisCtlName) then
					pcall(function() RouterProxy[thisCtlName].EventHandler = nil end)
				end
			end
			BoundSelectCtls = {}
		end
	
		-- Track routes changed anywhere else in the design, not just by this plugin.
		local function BindRouter()
			UnbindRouter()
			if RouterProxy == nil then return end
			for thisDest = 1, DestCount do
				local selCtl = ResolveSelectCtl(thisDest)
				if selCtl ~= nil then
					pcall(function()
						RouterProxy[selCtl].EventHandler = function() RefreshAll() end
					end)
					BoundSelectCtls[thisDest] = selCtl
				end
			end
		end
	
		local function ReportBinding()
			if RouterProxy == nil then
				SetString(Controls["router_style"], "")
				SetStatus(STATUS.MISSING, "No router selected")
				return
			end
			local resolved = 0
			for thisDest = 1, DestCount do
				if ResolveSelectCtl(thisDest) ~= nil then resolved = resolved + 1 end
			end
			local firstCtl = ResolveSelectCtl(1)
			if firstCtl == nil then
				SetString(Controls["router_style"], "unresolved")
				SetStatus(STATUS.FAULT, "No output select control found on router")
			elseif string.find(firstCtl, "output.", 1, true) then
				SetString(Controls["router_style"], "output.N.select")
			else
				SetString(Controls["router_style"], "select.N")
			end
			if firstCtl ~= nil then
				if resolved < DestCount then
					SetStatus(STATUS.COMPROMISED,
						fmt("Router has %d of %d configured outputs", resolved, DestCount))
				else
					SetStatus(STATUS.OK, fmt("%d outputs bound", resolved))
				end
			end
			dbg("router outputs resolved", resolved, "of", DestCount, "style", firstCtl or "none")
		end
	
		local function RebuildRouterProxy()
			UnbindRouter()
			RouterProxy    = nil
			SelectCtlCache = {}
			local sel = Controls["router_select"]
			local name = (sel ~= nil and sel.String) or ""
			if name ~= "" then
				local ok, comp = pcall(Component.New, name)
				if ok and comp ~= nil then RouterProxy = comp end
			end
			SetBool(Controls["router_found"], RouterProxy ~= nil)
			ReportBinding()
			BindRouter()
			RefreshAll()
		end
	
		-- Accept a component as a router if its Type says so, or if either select
		-- naming form is present on it.
		local function LooksLikeRouter(comp)
			local ok, ctrls = pcall(Component.GetControls, comp)
			if not ok or ctrls == nil then return false end
			for _, thisCtl in ipairs(ctrls) do
				if thisCtl.Name == "select.1" or thisCtl.Name == "output.1.select" then
					return true
				end
			end
			return false
		end
	
		local function DiscoverRouters()
			local list = {}
			local ok, comps = pcall(Component.GetComponents)
			if not ok or comps == nil then return list end
			for _, thisComp in ipairs(comps) do
				local isRouter = false
				if type(thisComp.Type) == "string"
					and string.find(string.lower(thisComp.Type), "router", 1, true) then
					isRouter = true
				end
				if not isRouter then
					local okNew, proxy = pcall(Component.New, thisComp.Name)
					if okNew and proxy ~= nil then isRouter = LooksLikeRouter(proxy) end
				end
				if isRouter then table.insert(list, thisComp.Name) end
			end
			table.sort(list)
			return list
		end
	
		local function RefreshRouterList()
			local sel = Controls["router_select"]
			if sel == nil then return end
			local list = DiscoverRouters()
			local current = sel.String
			if current ~= nil and current ~= "" then
				local present = false
				for _, thisName in ipairs(list) do
					if thisName == current then present = true end
				end
				if not present then table.insert(list, current) end
			end
			table.insert(list, 1, "")   -- blank option = not bound
			sel.Choices = list
			RebuildRouterProxy()
		end
	
		-- ===== Event handlers =====
		if Controls["router_select"] ~= nil then
			Controls["router_select"].EventHandler = function()
				RebuildRouterProxy()
			end
		end
	
		-- Mode buttons re-assert the authoritative mode state rather than forcing
		-- the pressed button, so the pair cannot latch both on.
		--
		-- Only a button going HIGH is a request. A low event is either this plugin's
		-- own exclusivity write arriving after the suppression guard dropped, or the
		-- operator pressing the already-active button. Adopting a low event as a
		-- request makes the pair fight each other and thrash.
		if Controls["mode_matrix"] ~= nil then
			Controls["mode_matrix"].EventHandler = function(ctl)
				if Suppressed() then return end
				if not ctl.Boolean then
					ApplyMode()
					return
				end
				Mode = MODE_MATRIX
				ApplyMode()
			end
		end
		if Controls["mode_all"] ~= nil then
			Controls["mode_all"].EventHandler = function(ctl)
				if Suppressed() then return end
				if not ctl.Boolean then
					ApplyMode()
					return
				end
				Mode = MODE_ALL
				ApplyMode()
			end
		end
	
		for thisDest = 1, DestCount do
			local selectCtl = DestCtl("select", thisDest)
			if selectCtl ~= nil then
				selectCtl.EventHandler = function(ctl)
					if Suppressed() then return end
					-- A low event is a feedback write clearing this button, not a
					-- press. Re-assert authoritative state only.
					if not ctl.Boolean then
						WriteDestButtons()
						return
					end
					if Mode == MODE_MATRIX and DestVisible(thisDest) then
						if SelectOrder == ORDER_SOURCE then
							-- Source-first: the destination press is the route action.
							if SelectedSource ~= nil then SetRoute(thisDest, SelectedSource) end
						else
							SelectedDest = thisDest
						end
					end
					RefreshAll()
				end
			end
	
			-- Routed-source ComboBox. Picking a source routes this destination to it.
			local sourceCtl = DestCtl("source", thisDest)
			if sourceCtl ~= nil then
				sourceCtl.EventHandler = function(ctl)
					if Suppressed() then return end
					local wanted = ChoiceIndex[ctl.String or ""]
					-- Anything else is a stale readout rather than a request: an
					-- unrecognised string, a hidden entry, or One-To-All mode, where a
					-- single output cannot be routed on its own.
					if wanted == nil
						or Mode ~= MODE_MATRIX
						or not DestVisible(thisDest)
						or not SourceVisible(wanted) then
						WriteRouteReadouts()
						return
					end
					SetRoute(thisDest, wanted)
					RefreshAll()
				end
			end
	
			local visibleCtl = DestCtl("visible", thisDest)
			if visibleCtl ~= nil then
				visibleCtl.EventHandler = function()
					ApplyVisibility()
				end
			end
	
			local nameCtl = DestCtl("name", thisDest)
			if nameCtl ~= nil then
				nameCtl.EventHandler = function()
					if Suppressed() then return end
					WriteDestButtons()
					WriteRouteReadouts()
				end
			end
		end
	
		for thisSource = 1, SourceCount do
			local selectCtl = SourceCtl("select", thisSource)
			if selectCtl ~= nil then
				selectCtl.EventHandler = function(ctl)
					if Suppressed() then return end
					-- Only a press (going high) is a request. Clearing a previously
					-- lit source must never re-route to it.
					if not ctl.Boolean then
						WriteSourceButtons()
						return
					end
					if not SourceVisible(thisSource) then
						WriteSourceButtons()
						return
					end
					if Mode == MODE_MATRIX and SelectOrder == ORDER_SOURCE then
						-- Source-first: the press only arms the source; routing waits
						-- for a destination press.
						SelectedSource = thisSource
					elseif Mode == MODE_ALL then
						for eachDest = 1, DestCount do
							SetRoute(eachDest, thisSource)
						end
						dbgRoute("routed all destinations <- source", thisSource)
					elseif RouterProxy ~= nil then
						-- Destination-first: the press routes to the armed destination.
						SetRoute(SelectedDest, thisSource)
					else
						dbg("route ignored, no router bound")
					end
					-- Lit state comes from the router (or the arming selection),
					-- never from the press itself.
					RefreshAll()
				end
			end
	
			local visibleCtl = SourceCtl("visible", thisSource)
			if visibleCtl ~= nil then
				visibleCtl.EventHandler = function()
					ApplyVisibility()
				end
			end
	
			local nameCtl = SourceCtl("name", thisSource)
			if nameCtl ~= nil then
				nameCtl.EventHandler = function()
					if Suppressed() then return end
					-- A source name is also a choice on every routed-source combo.
					RefreshSourceChoices()
					WriteDestButtons()
					WriteRouteReadouts()
				end
			end
		end
	
		-- ===== Initialise =====
		SelectedDest   = FirstVisibleDest()
		SelectedSource = FirstVisibleSource()
		RefreshSourceChoices()
		ApplyMode()
		RefreshRouterList()
	
		-- Safety net: a router variant that does not raise change events on its
		-- select controls still gets picked up here. All writes are conditional, so
		-- a settled system produces no control events from this poll.
		local pollTimer = Timer.New()
		pollTimer.EventHandler = function()
			RefreshAll()
		end
		pollTimer:Start(2)
	
		dbg("initialised", SourceCount, "sources x", DestCount, "destinations, mode", Mode,
			"order", SelectOrder)
end
